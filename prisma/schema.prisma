// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum UserRole {
  CUSTOMER
  ADMIN
}

// SUSPENDED: the account is locked out (see account-suspension); it cannot log in or refresh tokens
enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum CredentialProvider {
  EMAIL
  GOOGLE
  PHONE
}

model Category {
  id        String   @id
  parentId  String?
  name      String   @db.VarChar(255)
  path      String   @unique @db.VarChar(500)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToCategory")
  products Product[]

  @@index([path])
}

model Product {
  id          String        @id
  categoryId  String
  name        String        @db.VarChar(255)
  description String?       @db.Text
  thumbnail   String?       @db.VarChar(500)
  status      ProductStatus @default(DRAFT)
  version     Int           @default(1)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Full-text search column. In the database it is a GENERATED column
  // (to_tsvector('simple', name || ' ' || description), 'simple' config) with a GIN index. Prisma's
  // schema language cannot express "generated", so the migration writes that part by hand. The
  // column is declared here, as Unsupported, only so that Prisma knows it exists: a column that is
  // missing from this file makes the next `migrate dev` generate a DROP COLUMN for it. Prisma never
  // writes it; only $queryRaw in PrismaProductRepository.findList() reads it. The dbgenerated(...) is
  // how Postgres reports a generated column's expression, written exactly as Postgres reports it so
  // that Prisma sees no difference between this file and the database.
  searchVector Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig, (((COALESCE(name, ''::character varying))::text || ' '::text) || COALESCE(description, ''::text)))"))

  category Category @relation(fields: [categoryId], references: [id])
  skus     Sku[]

  @@index([categoryId, status])
  @@index([searchVector], type: Gin)
}

model Sku {
  id         String   @id
  productId  String
  price      Decimal  @db.Decimal(10, 2)
  attributes Json
  skuCode    String   @unique @db.VarChar(100)
  barcode    String?  @unique @db.VarChar(100)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  stock        SkuStock?
  reservations Reservation[]

  @@index([productId])
}

// ReservationStatus: RESERVED = held for an unpaid order, CONFIRMED = paid (stock taken out of
// SkuStock.onHand), RELEASED = cancelled or expired before it was paid (stock given back),
// RETURNED = was CONFIRMED, then the order was cancelled before delivery and the stock put back into
// SkuStock.onHand. RELEASED and RETURNED are final; CONFIRMED can only move on to RETURNED.
enum ReservationStatus {
  RESERVED
  CONFIRMED
  RELEASED
  RETURNED
}

// How many units of a SKU are physically in the warehouse. What can be sold right now is
// `onHand - sum(qty of RESERVED reservations)`; that number lives only in Redis and is rebuilt from here.
// The hand-written migration adds CHECK ("onHand" >= 0), which Prisma's DSL cannot express.
model SkuStock {
  skuId     String   @id
  onHand    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Stock means nothing without its SKU, so it goes away with it
  sku Sku @relation(fields: [skuId], references: [id], onDelete: Cascade)
}

// One row per (order, SKU): who holds how many units, until when. The durable record behind the
// Redis counters. The hand-written migration adds CHECK (qty > 0).
model Reservation {
  id        String            @id
  orderId   String            @db.VarChar(100) // plain text: there is no order table yet
  skuId     String
  qty       Int
  status    ReservationStatus @default(RESERVED)
  expiresAt DateTime
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  // A SKU that was ever reserved cannot be deleted (RESTRICT): unpublish the product instead
  sku Sku @relation(fields: [skuId], references: [id], onDelete: Restrict)

  // One order holds a SKU at most once; also what stops a retried order from holding twice
  @@unique([orderId, skuId])
  @@index([status, expiresAt])
  @@index([skuId, status])
}

model User {
  id          String     @id
  displayName String?    @db.VarChar(255)
  avatarUrl   String?    @db.VarChar(500)
  role        UserRole   @default(CUSTOMER)
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  credentials UserCredential[]
  sessions    Session[]
  addresses   Address[]
  orders      Order[]
}

// A delivery address in a user's address book. At most 10 per user, and at most one with
// isDefault = true; both are kept by the code under a pessimistic lock on the User row, and the
// second one is also enforced by a partial unique index ("Address_userId_default_key" ON ("userId")
// WHERE "isDefault" = true), hand-written in the migration because Prisma cannot express it.
// The user picks a ward from the administrative units; the province follows from the ward. The names
// are copies taken when the address was saved ("Thành phố Hà Nội", "Phường Ba Đình"), so the address
// still reads the same if the units are renamed later.
model Address {
  id            String   @id
  userId        String
  recipientName String   @db.VarChar(100)
  phone         String   @db.VarChar(20)
  provinceCode  String   @db.VarChar(2)
  provinceName  String   @db.VarChar(100)
  wardCode      String   @db.VarChar(5)
  wardName      String   @db.VarChar(100)
  street        String   @db.VarChar(255)
  label         String?  @db.VarChar(50)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  province Province @relation(fields: [provinceCode], references: [code], onDelete: Restrict)
  ward     Ward     @relation(fields: [wardCode], references: [code], onDelete: Restrict)

  @@index([userId])
}

enum SessionRevokeReason {
  LOGOUT
  LOGOUT_OTHERS
  LOGOUT_ALL
  REUSE_DETECTED
  ADMIN
  PASSWORD_RESET
  PASSWORD_CHANGED
}

// Một dòng = một lần đăng nhập trên một thiết bị. `id` chính là `sid` nằm trong access token.
//
// Thuật ngữ:
//  - rotate : đổi refresh token (RT) cũ lấy RT mới TRONG CÙNG session (mỗi lần AT hết hạn, client refresh).
//             Session giữ nguyên (cùng id, cùng createdAt); RT cũ chỉ dùng được một lần.
//  - revoke : đóng session chủ động (đăng xuất, thu hồi thiết bị, phát hiện RT cũ bị dùng lại).
//             RT của nó hết tác dụng và AT bị chặn ngay nhờ cờ trong Redis.
//  - expire : session hết hạn tự nhiên (quá expiresAt), không ai làm gì cả.
//  Một session còn sống khi revokedAt là null VÀ expiresAt còn ở tương lai.
model Session {
  id                       String               @id // uuid
  userId                   String
  // sha256 của RT hiện hành — không bao giờ lưu RT thô
  refreshTokenHash         String               @unique
  // RT bị thay ở lần rotate gần nhất. Giữ lại để nhận ra "RT cũ đã bị đổi rồi mà vẫn có người đem ra dùng"
  previousRefreshTokenHash String?
  // Lần gần nhất RT được đổi sang RT mới (rotate); null = chưa refresh lần nào.
  // Phân biệt "vừa đổi < 15 giây" (2 tab refresh cùng lúc, hợp lệ) với "đổi từ lâu" (RT cũ bị dùng lại, đáng ngờ)
  rotatedAt                DateTime?
  // User-Agent cắt ngắn — chỉ để hiển thị cho chủ session nhận ra thiết bị
  deviceName               String               @db.VarChar(255)
  // IP lần dùng gần nhất (lúc đăng nhập, rồi cập nhật mỗi lần refresh)
  ipAddress                String               @db.VarChar(64)
  // Lần gần nhất thiết bị này dùng session (đăng nhập, rồi mỗi lần refresh) — để hiện "dùng lần cuối lúc nào"
  lastUsedAt               DateTime
  // Lúc đăng nhập, tức lúc session ra đời. KHÔNG BAO GIỜ ĐỔI — là mốc tính trần 30 ngày
  createdAt                DateTime             @default(now())
  // Hạn chót: quá giờ này session không dùng được nữa. Mỗi lần refresh được gia hạn thêm 7 ngày
  // nhưng không vượt createdAt + 30 ngày: min(now + 7 ngày, createdAt + 30 ngày)
  expiresAt                DateTime
  // Lúc session bị đóng chủ động (revoke); null = chưa bị đóng. Chỉ đặt một lần
  revokedAt                DateTime?
  // Vì sao bị đóng: đăng xuất, thu hồi thiết bị khác, đăng xuất tất cả, RT cũ bị dùng lại, hoặc admin
  revokedReason            SessionRevokeReason?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([previousRefreshTokenHash])
}

model UserCredential {
  id         String             @id
  userId     String
  provider   CredentialProvider
  // identifier = email (EMAIL), phone number (PHONE), google_sub (GOOGLE)
  identifier String             @db.VarChar(255)
  // secret = argon2 hash (EMAIL/PHONE OTP). null với OAuth provider.
  secret     String?            @db.VarChar(500)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, identifier]) // không thể có 2 account cùng identifier/provider
  @@index([userId])
}

// Vietnamese administrative units after the 2025 merger: two levels, province-level units (34) and the
// wards/communes/special zones under them (3,321); there is no district level. Reference data, filled by
// scripts/seed-administrative-units.sql. Names are stored WITHOUT the kind ("Ba Đình"); the kind is in
// `type` and the full name ("Phường Ba Đình") is put together when it is shown.
// Hand-written in the migration (Prisma cannot express them): CHECKs on the code length and non-empty names.

// CITY = one of the 6 centrally-run cities (Hà Nội, Hải Phòng, Huế, Đà Nẵng, Hồ Chí Minh, Cần Thơ)
enum ProvinceType {
  CITY
  PROVINCE
}

enum WardType {
  WARD
  COMMUNE
  SPECIAL_ZONE
}

model Province {
  code String       @id @db.VarChar(2)
  name String       @db.VarChar(100)
  type ProvinceType

  wards     Ward[]
  addresses Address[]
}

model Ward {
  code         String   @id @db.VarChar(5)
  provinceCode String   @db.VarChar(2)
  name         String   @db.VarChar(100)
  type         WardType

  province  Province  @relation(fields: [provinceCode], references: [code], onDelete: Restrict)
  addresses Address[]

  @@index([provinceCode])
}

// OrderStatus: PENDING = placed, waiting to be paid (online) or to be confirmed (cash on delivery);
// PAYMENT_PROCESSING = an online payment is running; CONFIRMED = paid or cash on delivery accepted, stock
// taken out of the warehouse; SHIPPING, DELIVERED = on the way, handed over. CANCELLED = the customer
// cancelled; EXPIRED = not paid in time (or the stock held for a cash-on-delivery order was lost).
// DELIVERED, CANCELLED and EXPIRED are final. The allowed moves are in the orders module.
enum OrderStatus {
  PENDING
  PAYMENT_PROCESSING
  CONFIRMED
  SHIPPING
  DELIVERED
  CANCELLED
  EXPIRED
}

// ONLINE = paid before the goods leave; COD = cash on delivery
enum PaymentMethod {
  ONLINE
  COD
}

// An order. Its id is derived from (user, idempotency key), so the same request always meets the
// same row. A copy of what the customer bought and where it goes is kept in the order itself
// (items, shippingAddress): changing a price or an address later never changes an order.
// stockReturnPending = the order was cancelled after its stock had been taken out of the warehouse
// and that stock has not been put back yet (cleared once it is).
// Hand-written in the migration (Prisma cannot express them): CHECKs on total and version, and a
// partial index on the orders whose stock is still to be put back.
model Order {
  id                 String        @id
  userId             String
  idempotencyKey     String        @db.VarChar(100)
  paymentMethod      PaymentMethod
  status             OrderStatus   @default(PENDING)
  version            Int           @default(1)
  stockReturnPending Boolean       @default(false)
  total              Decimal       @db.Decimal(12, 2)
  shippingAddress    Json
  expiresAt          DateTime
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items OrderItem[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, expiresAt])
}

// One line of an order, as it was when the order was placed. skuId is plain text, NOT a foreign
// key: the line must survive the SKU being deleted. Hand-written CHECKs: unitPrice, lineTotal >= 0, quantity > 0.
model OrderItem {
  id          String  @id
  orderId     String
  skuId       String
  productName String  @db.VarChar(255)
  thumbnail   String? @db.VarChar(500)
  attributes  Json
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal @db.Decimal(12, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, skuId])
}

// Something that happened and must reach RabbitMQ (the transactional outbox): written in the SAME
// transaction as the change it reports, sent later by a background process. seq keeps the order;
// publishedAt is empty until the event has been sent. Hand-written in the migration: a partial
// index on the rows not yet sent.
model OutboxEvent {
  id          String    @id
  seq         BigInt    @unique @default(autoincrement())
  type        String    @db.VarChar(100)
  aggregateId String    @db.VarChar(100)
  payload     Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
}
