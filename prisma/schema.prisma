// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum CredentialProvider {
  EMAIL
  GOOGLE
  PHONE
}

model Category {
  id        String     @id
  parentId  String?
  name      String     @db.VarChar(255)
  path      String     @unique @db.VarChar(500)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  
  parent    Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryToCategory")
  products  Product[]

  @@index([path])
}

model Product {
  id          String        @id
  categoryId  String
  name        String        @db.VarChar(255)
  description String?       @db.Text
  thumbnail   String?       @db.VarChar(500)
  status      ProductStatus @default(DRAFT)
  version     Int           @default(1)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category    Category      @relation(fields: [categoryId], references: [id])
  skus        Sku[]

  @@index([categoryId, status])
}

// Note: the Product table also has a generated `searchVector` tsvector
// column (name || description, 'simple' config) with a GIN index, added by
// the hand-written migration prisma/migrations/1_add_product_search_vector
// rather than declared here — Prisma's schema DSL can't express a
// generated column. It's queried only via $queryRaw in
// PrismaProductRepository.findList().

model Sku {
  id         String   @id
  productId  String
  price      Decimal  @db.Decimal(10, 2)
  attributes Json
  skuCode    String   @unique @db.VarChar(100)
  barcode    String?  @unique @db.VarChar(100)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model User {
  id          String           @id
  displayName String?          @db.VarChar(255)
  avatarUrl   String?          @db.VarChar(500)
  role        UserRole         @default(CUSTOMER)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  credentials UserCredential[]
  sessions    Session[]
}

enum SessionRevokeReason {
  LOGOUT
  LOGOUT_OTHERS
  LOGOUT_ALL
  REUSE_DETECTED
  ADMIN
  PASSWORD_RESET
  PASSWORD_CHANGED
}

// Một dòng = một lần đăng nhập trên một thiết bị. `id` chính là `sid` nằm trong access token.
//
// Thuật ngữ:
//  - rotate : đổi refresh token (RT) cũ lấy RT mới TRONG CÙNG session (mỗi lần AT hết hạn, client refresh).
//             Session giữ nguyên (cùng id, cùng createdAt); RT cũ chỉ dùng được một lần.
//  - revoke : đóng session chủ động (đăng xuất, thu hồi thiết bị, phát hiện RT cũ bị dùng lại).
//             RT của nó hết tác dụng và AT bị chặn ngay nhờ cờ trong Redis.
//  - expire : session hết hạn tự nhiên (quá expiresAt), không ai làm gì cả.
//  Một session còn sống khi revokedAt là null VÀ expiresAt còn ở tương lai.
model Session {
  id                       String               @id // uuid
  userId                   String
  // sha256 của RT hiện hành — không bao giờ lưu RT thô
  refreshTokenHash         String               @unique
  // RT bị thay ở lần rotate gần nhất. Giữ lại để nhận ra "RT cũ đã bị đổi rồi mà vẫn có người đem ra dùng"
  previousRefreshTokenHash String?
  // Lần gần nhất RT được đổi sang RT mới (rotate); null = chưa refresh lần nào.
  // Phân biệt "vừa đổi < 15 giây" (2 tab refresh cùng lúc, hợp lệ) với "đổi từ lâu" (RT cũ bị dùng lại, đáng ngờ)
  rotatedAt                DateTime?
  // User-Agent cắt ngắn — chỉ để hiển thị cho chủ session nhận ra thiết bị
  deviceName               String               @db.VarChar(255)
  // IP lần dùng gần nhất (lúc đăng nhập, rồi cập nhật mỗi lần refresh)
  ipAddress                String               @db.VarChar(64)
  // Lần gần nhất thiết bị này dùng session (đăng nhập, rồi mỗi lần refresh) — để hiện "dùng lần cuối lúc nào"
  lastUsedAt               DateTime
  // Lúc đăng nhập, tức lúc session ra đời. KHÔNG BAO GIỜ ĐỔI — là mốc tính trần 30 ngày
  createdAt                DateTime             @default(now())
  // Hạn chót: quá giờ này session không dùng được nữa. Mỗi lần refresh được gia hạn thêm 7 ngày
  // nhưng không vượt createdAt + 30 ngày: min(now + 7 ngày, createdAt + 30 ngày)
  expiresAt                DateTime
  // Lúc session bị đóng chủ động (revoke); null = chưa bị đóng. Chỉ đặt một lần
  revokedAt                DateTime?
  // Vì sao bị đóng: đăng xuất, thu hồi thiết bị khác, đăng xuất tất cả, RT cũ bị dùng lại, hoặc admin
  revokedReason            SessionRevokeReason?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([previousRefreshTokenHash])
}

model UserCredential {
  id         String             @id
  userId     String
  provider   CredentialProvider
  // identifier = email (EMAIL), phone number (PHONE), google_sub (GOOGLE)
  identifier String             @db.VarChar(255)
  // secret = argon2 hash (EMAIL/PHONE OTP). null với OAuth provider.
  secret     String?            @db.VarChar(500)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, identifier]) // không thể có 2 account cùng identifier/provider
  @@index([userId])
}
