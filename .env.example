# Copy this file to .env and fill in the values marked CHANGE-ME. .env is not committed.
# Every setting that has a default in the code says so; leave it out to use the default.

PORT=3000
# NODE_ENV=development
# Postgres from docker-compose.yml (database ecom_db). Tests use .env.test with the database ecom_test.
DATABASE_URL="postgresql://root:rootpassword@localhost:5432/ecom_db?schema=public"
# Redis from docker-compose.yml
REDIS_URL="redis://localhost:6379/0"
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
# Comma separated list of the websites that may call the API from a browser (leave out in development)
# CORS_ORIGINS=https://ecom.com,https://admin.ecom.com
# Pins the machine id used for ids (default: derived from the host name)
# PROCESS_ID=1

# Background jobs: rabbitmq (default), or inline (runs inside the request; development and tests only)
# JOB_QUEUE=rabbitmq
# RabbitMQ from docker-compose.yml; required in production
# RABBITMQ_URL=amqp://admin:admin@localhost:5672

# Auth
# At least 32 characters. CHANGE-ME: make one up, for example with: openssl rand -hex 32
JWT_ACCESS_SECRET="CHANGE-ME-a-long-random-string-of-at-least-32-characters"
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
# How long a sign-in can last in total, in seconds (default 2592000, 30 days)
# SESSION_ABSOLUTE_TTL_SECONDS=2592000

# Email: log (prints the message in the console, development only) or smtp
# With smtp, the verification codes are sent through your SMTP server
EMAIL_PROVIDER=log
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER and SMTP_PASS go together. CHANGE-ME: for Gmail use an app password, never your own password
# SMTP_USER=you@example.com
# SMTP_PASS="CHANGE-ME"
EMAIL_FROM="Ecommerce Platform <you@example.com>"
APP_NAME="Ecommerce Platform"

# Sign in with Google (the client id is public; no client secret is needed). Comma separated.
# GOOGLE_CLIENT_IDS=123456789-abc.apps.googleusercontent.com

# Cloudinary (profile pictures). All three together, or none of them.
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=CHANGE-ME
# CLOUDINARY_API_SECRET=CHANGE-ME
# Folder for the pictures (default: ecom)
# CLOUDINARY_FOLDER=ecom


# Inventory (stock held for orders that are not paid yet)
# How long the stock is held for an unpaid order, in minutes (1 to 10080)
RESERVATION_TTL_MINUTES=15
# How often the sweep runs that gives back expired holds and repairs half-done ones, in seconds (0 = off)
INVENTORY_MAINTENANCE_INTERVAL_SECONDS=60
# How old a being-held record must be before it counts as left behind by a dead process, in seconds
INVENTORY_INFLIGHT_GRACE_SECONDS=120

# Database connection pool (per copy of the application; Postgres allows 200, see docker-compose.yml)
# Most connections one copy of the application opens to Postgres (1 to 1000)
DATABASE_POOL_MAX=100
# How long a query waits for a free connection before it fails, in milliseconds (0 = wait for ever)
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000

# Orders
# How often the outbox is read and its events sent to RabbitMQ, in milliseconds (0 = off)
ORDER_OUTBOX_INTERVAL_MS=1000
# How many outbox events one round sends at most (1 to 1000)
ORDER_OUTBOX_BATCH_SIZE=50
# How often the sweep runs (expired unpaid orders, cash-on-delivery orders left half-done, stock still to put back), in seconds (0 = off)
ORDER_MAINTENANCE_INTERVAL_SECONDS=60

# Payments
# Which payment gateway to use: fake (a stand-in inside the application, never moves real money)
PAYMENT_GATEWAY=fake
# Key that signs the webhooks of the fake gateway, at least 16 characters (CHANGE-ME in any shared environment)
PAYMENT_FAKE_WEBHOOK_SECRET=CHANGE-ME-fake-gateway-webhook-secret
# How long a customer has to pay once they start, in minutes (1 to 1440); the stock is held that long
PAYMENT_WINDOW_MINUTES=15
# How often the sweep runs (asks the gateway about lost results, finishes half-done payments, refunds), in seconds (0 = off)
PAYMENT_MAINTENANCE_INTERVAL_SECONDS=60
# How old a webhook may be before it is refused, in seconds (1 to 3600); stops a recorded one being replayed
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
